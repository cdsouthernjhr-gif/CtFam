# FamilySync configuration reference.
#
# The Flutter app does NOT read this file at runtime. Build-time values are
# passed with:   flutter run --dart-define-from-file=env/dev.json
# Copy env/example.json to env/dev.json (git-ignored) and fill it in.
#
# ---- Client (safe to ship in the APK) --------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key ONLY (sb_publishable_...). The app refuses sb_secret_ and
# service_role keys at startup.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
INVITE_LINK_BASE=familysync://app/join
# Firebase client identifiers (public; push is disabled when empty). See docs/FIREBASE_SETUP.md.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# ---- Server only (Supabase Edge Function secrets — NEVER in the app) -------
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into Edge Functions by Supabase.
# FCM_SERVICE_ACCOUNT_JSON=<Firebase service account JSON; Edge Function secret only, never commit>
# The push webhook secret is generated inside the database (Supabase Vault,
# name 'push_webhook_secret') and never leaves it.
